{
  "name": "coffee-delivery",
  "private": true,
  "workspaces": [
    "apps/app"
  ],
  "scripts": {
    "code:fix": "node scripts/run-task.mjs code:fix",
    "lint": "node scripts/run-task.mjs lint",
    "types:check": "node scripts/run-task.mjs types:check",
    "test": "node scripts/run-task.mjs test",
    "test:e2e": "node scripts/run-task.mjs test:e2e",
    "build": "node scripts/run-task.mjs build",
    "ci": "node scripts/ci.mjs",
    "skills:link": "node scripts/link-skills.mjs",
    "env:setup": "node scripts/env-setup.mjs",
    "infra:up": "node scripts/env-setup.mjs && docker compose --env-file .env.local up --detach --wait",
    "infra:down": "node scripts/env-setup.mjs && docker compose --env-file .env.local down",
    "local:setup": "yarn install && yarn env:setup && yarn infra:up",
    "api:dev": "node scripts/api-dev.mjs",
    "load:smoke": "node scripts/load.mjs smoke",
    "load": "node scripts/load.mjs load",
    "load:stress": "node scripts/load.mjs stress",
    "load:spike": "node scripts/load.mjs spike",
    "load:soak": "node scripts/load.mjs soak",
    "app:dev": "yarn --cwd apps/app dev",
    "prepare": "lefthook install && node scripts/link-skills.mjs",
    "lighthouse": "node scripts/lighthouse-home.mjs",
    "docker:build": "docker compose --env-file .env.local -f compose.yaml -f compose.packaged.yaml build api app",
    "docker:up": "node scripts/env-setup.mjs && docker compose --env-file .env.local -f compose.yaml -f compose.packaged.yaml up --detach --wait postgres api app",
    "docker:down": "docker compose --env-file .env.local -f compose.yaml -f compose.packaged.yaml stop api app",
    "db:backup": "node scripts/db-backup.mjs",
    "db:restore": "node scripts/db-restore.mjs"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@napi-rs/canvas": "1.1.0",
    "chrome-launcher": "1.2.3",
    "lefthook": "2.2.2",
    "lighthouse": "13.6.0",
    "lint-staged": "17.6.0",
    "oxfmt": "0.74.0",
    "oxlint": "1.91.0"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs}": [
      "oxlint --fix",
      "oxfmt --write --no-error-on-unmatched-pattern"
    ],
    "*.{json,jsonc,css,html}": "oxfmt --write --no-error-on-unmatched-pattern"
  },
  "engines": {
    "node": ">=22.12"
  },
  "packageManager": "yarn@1.22.22"
}
