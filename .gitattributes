# Text files use LF in the repository and in the working tree, on every operating system.
* text=auto eol=lf

# Windows batch files need CRLF.
*.bat text eol=crlf

# Binary files are never converted.
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.pdf binary
*.fig binary
*.jar binary
