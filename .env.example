# Values for local development only. They are not secrets and must never be used in a shared or production environment.
# `yarn env:setup` copies this file to .env.local, which Git ignores. Change .env.local, not this file, for your machine.

# PostgreSQL (compose.yaml)
POSTGRES_DB=coffee_delivery
POSTGRES_USER=coffee_delivery
POSTGRES_PASSWORD=coffee_delivery_dev
POSTGRES_PORT=5432

# OpenTelemetry (apps/api, application.yaml). Optional: the API sends traces and metrics to this collector, which
# `yarn infra:up` starts. Uncomment it only to send them somewhere else.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
